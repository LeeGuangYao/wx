:host { display: block; height: 100%; }

.spread-wrap {
  height: 100%;
  box-sizing: border-box;
  padding: 8rpx 42rpx 16rpx;
  display: flex;
  flex-direction: column;
}

.folio-header {
  flex: none;
  height: 62rpx;
  display: flex;
  align-items: center;
  gap: 14rpx;
  white-space: nowrap;
}

.folio-title {
  font-family: "Songti SC", "SongtiSC-Regular", "STSong", serif;
  font-size: 32rpx;
  line-height: 1.1;
  letter-spacing: 1rpx;
  overflow: hidden;
  text-overflow: ellipsis;
}

.folio-title.chapter-white { font-family: -apple-system, BlinkMacSystemFont, sans-serif; font-size: 46rpx; font-weight: 200; letter-spacing: -2rpx; }
.folio-aside { margin-left: auto; font-size: 14rpx; letter-spacing: 3rpx; opacity: .8; }
.folio-aside.chapter-palace { font-family: Georgia, serif; font-size: 22rpx; letter-spacing: 0; }

.spread-canvas {
  position: relative;
  flex: 1;
  min-height: 0;
  overflow: hidden;
}

.photo-paper {
  position: absolute;
  transform-origin: 50% 50%;
  background: #f5f2ed;
  overflow: visible;
  transition: opacity .38s ease, filter .4s ease;
  opacity: .52;
}

.photo-paper.chapter-palace { padding: 8rpx; box-sizing: border-box; background: #f3eadb; box-shadow: 0 10rpx 30rpx rgba(72,54,30,.16); }
.photo-paper.chapter-golden { padding: 8rpx; box-sizing: border-box; background: #e3d5bc; box-shadow: 0 12rpx 28rpx rgba(0,0,0,.24); }
.photo-paper.chapter-white { background: transparent; }
.photo-paper.photo-visible { opacity: 1; }
.spread-photo { display: block; width: 100%; height: 100%; background: transparent; opacity: 0; transition: opacity .45s ease; }
.spread-photo.photo-loaded { opacity: 1; }
.photo-placeholder { width: 100%; height: 100%; background: linear-gradient(110deg, rgba(255,255,255,.02) 20%, rgba(255,255,255,.11) 42%, rgba(255,255,255,.02) 64%); background-size: 220% 100%; animation: shimmer 1.25s ease-in-out infinite; }
.chapter-palace .photo-placeholder, .chapter-white .photo-placeholder { background-color: rgba(255,255,255,.4); }
.photo-failed { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; font-size: 20rpx; color: rgba(255,255,255,.72); background: rgba(0,0,0,.26); }
.chapter-palace .photo-failed, .chapter-white .photo-failed { color: #655844; }

.mountain-note { position: absolute; z-index: 0; left: 0; bottom: 13%; width: 36%; display: flex; flex-direction: column; color: #d8d1c8; font-family: "Songti SC", serif; font-size: 25rpx; line-height: 1.7; }
.note-rule { width: 40rpx; height: 2rpx; background: rgba(229,217,201,.7); margin-bottom: 14rpx; }
.note-number { margin-top: 12rpx; font-size: 17rpx; letter-spacing: 4rpx; }
.sequence-line { position: absolute; z-index: 0; left: 50%; top: 8%; bottom: 8%; width: 1rpx; background: rgba(229,217,201,.35); }
.palace-wash { position: absolute; z-index: 0; top: 2%; bottom: 2%; left: 0; width: 49%; background: rgba(251,245,233,.34); }
.palace-divider { position: absolute; z-index: 0; top: 3%; bottom: 3%; left: 50%; width: 1rpx; background: rgba(141,115,84,.22); }
.white-page-number { position: absolute; right: 7%; top: 3%; z-index: 0; color: rgba(36,39,34,.07); font-size: 196rpx; font-weight: 100; }
.golden-glow { position: absolute; z-index: 0; left: 9%; top: 12%; width: 80%; height: 74%; border-radius: 50%; background: rgba(199,151,88,.12); filter: blur(34rpx); }

@keyframes shimmer { from { background-position: 100% 0; } to { background-position: -100% 0; } }
