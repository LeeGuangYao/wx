.album-page { position: fixed; inset: 0; display: flex; flex-direction: column; overflow: hidden; transition: background-color .3s ease, color .3s ease; }
.album-top { box-sizing: content-box; flex: none; display: flex; align-items: center; justify-content: space-between; padding-left: 40rpx; padding-right: 210rpx; }
.brand-mark { display: flex; flex-direction: column; gap: 5rpx; }
.brand-kicker { font-size: 13rpx; letter-spacing: 4rpx; opacity: .55; }
.brand-name { font-family: "Songti SC", "SongtiSC-Regular", serif; font-size: 35rpx; letter-spacing: 3rpx; }
.top-actions { display: flex; align-items: center; }
.directory-trigger { height: 58rpx; display: flex; align-items: center; gap: 9rpx; padding: 0 16rpx; border: 1rpx solid currentColor; border-radius: 40rpx; opacity: .76; font-size: 21rpx; }
.directory-glyph { font-size: 27rpx; line-height: 1; }
.chapter-tabs { flex: none; display: flex; margin: 16rpx 35rpx 0; border-bottom: 1rpx solid rgba(127,127,127,.2); }
.chapter-tab { position: relative; flex: 1; height: 77rpx; display: flex; align-items: center; justify-content: center; gap: 8rpx; opacity: .55; }
.chapter-tab-active { opacity: 1; }
.chapter-tab-number { font-size: 15rpx; letter-spacing: 1rpx; }
.chapter-tab-title { font-family: "Songti SC", "SongtiSC-Regular", serif; font-size: 23rpx; white-space: nowrap; }
.chapter-tab-rule { position: absolute; height: 2rpx; left: 18%; right: 18%; bottom: -1rpx; background: currentColor; }
.chapter-heading { flex: none; display: flex; align-items: center; justify-content: space-between; padding: 20rpx 42rpx 0; }
.chapter-subtitle { font-family: "Songti SC", "SongtiSC-Regular", serif; font-size: 22rpx; letter-spacing: 2rpx; opacity: .77; }
.chapter-current { font-size: 15rpx; letter-spacing: 2rpx; opacity: .56; }
.folio-swiper { flex: 1; min-height: 0; width: 100%; }
.folio-swiper swiper-item { overflow: hidden; }
.album-footer { flex: none; padding-top: 10rpx; }
.folio-counter { height: 43rpx; padding: 0 42rpx; display: flex; align-items: center; gap: 12rpx; }
.folio-current,.folio-total { font-family: Georgia, serif; font-size: 20rpx; letter-spacing: 1rpx; }
.counter-line { width: 38rpx; height: 1rpx; background: currentColor; opacity: .42; }
.folio-total { opacity: .56; }
.folio-caption { margin-left: 3rpx; font-size: 12rpx; letter-spacing: 2rpx; opacity: .48; }
.swipe-hint { margin-left: auto; font-size: 17rpx; letter-spacing: 1rpx; opacity: .48; }
.thumb-strip { width: 100%; height: 100rpx; white-space: nowrap; }
.thumb-track { display: inline-flex; align-items: center; gap: 11rpx; padding: 6rpx 38rpx 15rpx; }
.thumb-item { width: 89rpx; height: 66rpx; flex: none; box-sizing: border-box; opacity: .56; border: 2rpx solid transparent; padding: 3rpx; transition: opacity .25s ease, border-color .25s ease; }
.thumb-current { opacity: 1; border-color: currentColor; }
.thumb-image,.thumb-placeholder { display: block; width: 100%; height: 100%; background: rgba(127,127,127,.18); }
.directory-mask { position: absolute; inset: 0; z-index: 10; display: flex; align-items: flex-end; background: rgba(9,8,7,.46); backdrop-filter: blur(5px); }
.directory-panel { box-sizing: border-box; width: 100%; max-height: 86%; min-height: 72%; padding: 14rpx 38rpx 0; padding-bottom: calc(env(safe-area-inset-bottom) + 18rpx); display: flex; flex-direction: column; color: #403a34; background: #f4f0e9; border-radius: 28rpx 28rpx 0 0; animation: rise .25s ease-out; }
.directory-handle { flex: none; width: 68rpx; height: 6rpx; border-radius: 6rpx; background: #c9c1b6; margin: 0 auto 24rpx; }
.directory-heading { display: flex; justify-content: space-between; align-items: center; flex: none; }
.directory-heading>view { display: flex; flex-direction: column; gap: 5rpx; }
.directory-overline { font-size: 13rpx; letter-spacing: 4rpx; color: #958b7e; }
.directory-title { font-family: "Songti SC", "SongtiSC-Regular", serif; font-size: 35rpx; letter-spacing: 2rpx; }
.directory-close { padding: 0 8rpx; color: #8c8378; font-size: 45rpx; line-height: 1; }
.directory-switch { flex: none; display: flex; gap: 34rpx; padding: 22rpx 0 18rpx; border-bottom: 1rpx solid rgba(64,58,52,.12); }
.directory-switch-item { padding-bottom: 8rpx; color: #968c80; font-size: 22rpx; }
.directory-switch-item.switch-on { color: #403a34; border-bottom: 2rpx solid #766a5d; }
.directory-scroll { flex: 1; min-height: 0; padding-top: 11rpx; }
.directory-chapter { box-sizing: border-box; min-height: 136rpx; margin: 12rpx 0; padding: 22rpx 25rpx; display: flex; align-items: center; justify-content: space-between; border: 1rpx solid rgba(64,58,52,.1); background: #e8e2d9; }
.directory-chapter.chapter-mountains { color: #f1ebe1; background: #45413c; }
.directory-chapter.chapter-palace { background: #e9decc; }
.directory-chapter.chapter-white { background: #fbfbf8; }
.directory-chapter.chapter-golden { color: #efe5d4; background: #292522; }
.directory-chapter-copy { display: flex; flex-direction: column; gap: 5rpx; }
.directory-chapter-number { font-size: 13rpx; letter-spacing: 3rpx; opacity: .66; }
.directory-chapter-title { font-family: "Songti SC", "SongtiSC-Regular", serif; font-size: 31rpx; letter-spacing: 2rpx; }
.directory-chapter-subtitle { font-size: 18rpx; opacity: .74; }
.directory-chapter-count { font-size: 18rpx; opacity: .7; }
.directory-photo-browser { flex: 1; min-height: 0; display: flex; flex-direction: column; }
.directory-chapter-filters { flex: none; height: 76rpx; white-space: nowrap; }
.filter-pill { display: inline-flex; align-items: center; height: 48rpx; box-sizing: border-box; margin: 12rpx 12rpx 0 0; padding: 0 20rpx; border: 1rpx solid rgba(64,58,52,.18); border-radius: 30rpx; font-size: 18rpx; color: #7b7166; }
.filter-pill-on { color: #f8f4ec; background: #49423a; border-color: #49423a; }
.directory-grid-scroll { padding-top: 7rpx; }
.directory-grid { display: flex; flex-wrap: wrap; justify-content: space-between; row-gap: 9rpx; }
.directory-photo { width: calc((100% - 18rpx) / 3); height: 185rpx; background: #e0dbd2; overflow: hidden; }
.directory-photo image { display: block; width: 100%; height: 100%; }
.directory-more { padding: 18rpx 0; text-align: center; color: #91877c; font-size: 17rpx; }
.directory-bottom { flex: none; padding: 14rpx 0 0; display: flex; align-items: center; justify-content: space-between; border-top: 1rpx solid rgba(64,58,52,.12); }
.directory-edition { color: #9b9186; font-size: 12rpx; letter-spacing: 2rpx; }
.vvdc-button { min-width: 112rpx; height: 51rpx; padding: 0 17rpx; box-sizing: border-box; display: flex; align-items: center; justify-content: center; gap: 8rpx; color: #82796f; border: 1rpx solid rgba(64,58,52,.2); border-radius: 28rpx; font-family: Georgia, serif; font-size: 19rpx; letter-spacing: 2rpx; }
.vvdc-dot { width: 7rpx; height: 7rpx; border-radius: 50%; background: #ab8e71; }
@keyframes rise { from { transform: translateY(24rpx); opacity: .6; } to { transform: translateY(0); opacity: 1; } }
