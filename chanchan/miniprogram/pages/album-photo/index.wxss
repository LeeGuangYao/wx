.photo-viewer { position: fixed; inset: 0; display: flex; flex-direction: column; overflow: hidden; color: #eee8dd; background: #171614; }
.viewer-nav { box-sizing: content-box; flex: none; display: flex; align-items: center; justify-content: space-between; padding-left: 28rpx; padding-right: 210rpx; }
.back-button { display: flex; align-items: center; gap: 5rpx; padding: 6rpx 12rpx 6rpx 0; font-size: 22rpx; opacity: .86; }
.back-arrow { flex: none; width: 14rpx; height: 14rpx; margin-left: 3rpx; box-sizing: border-box; border-left: 3rpx solid currentColor; border-bottom: 3rpx solid currentColor; transform: rotate(45deg); }
.viewer-name { max-width: 250rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: rgba(238,232,221,.57); font-size: 16rpx; letter-spacing: 1rpx; }
.photo-stage { position: relative; flex: 1; min-height: 0; width: 100%; }
.photo-zoom { display: flex; align-items: center; justify-content: center; width: 100%; height: 100%; }
.original-photo { position: absolute; top: 0; left: 0; display: block; width: 100vw; height: 100%; }
.photo-pending { opacity: 0; }
.viewer-state { position: absolute; z-index: 2; left: 0; right: 0; top: 50%; transform: translateY(-50%); display: flex; flex-direction: column; align-items: center; gap: 22rpx; color: rgba(238,232,221,.77); font-size: 21rpx; letter-spacing: 1rpx; pointer-events: none; }
.loading-ring { width: 49rpx; height: 49rpx; border: 2rpx solid rgba(238,232,221,.22); border-top-color: #d5bea0; border-radius: 50%; animation: spin .9s linear infinite; }
.viewer-error { color: #e5d6c1; }
.retry-button { pointer-events: auto; padding: 12rpx 27rpx; border: 1rpx solid rgba(238,232,221,.46); border-radius: 32rpx; }
.viewer-bottom { flex: none; padding: 19rpx 34rpx 0; display: flex; flex-direction: column; align-items: center; gap: 18rpx; }
.original-status { display: flex; align-items: center; justify-content: center; gap: 18rpx; color: rgba(238,232,221,.7); font-size: 18rpx; }
.original-retry { padding: 8rpx 15rpx; border: 1rpx solid rgba(238,232,221,.46); border-radius: 24rpx; }
.zoom-hint { color: rgba(238,232,221,.46); font-size: 16rpx; letter-spacing: 1rpx; }
.save-button { width: 100%; max-width: 580rpx; height: 82rpx; display: flex; align-items: center; justify-content: center; border: 1rpx solid rgba(228,213,191,.6); border-radius: 4rpx; color: #eee4d4; letter-spacing: 3rpx; font-family: "Songti SC", serif; font-size: 24rpx; }
.save-disabled { opacity: .35; }
@keyframes spin { to { transform: rotate(360deg); } }
